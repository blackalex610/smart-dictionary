# Edge Function secrets. For local `supabase functions serve --env-file supabase/functions/.env`.
# In production set them with `supabase secrets set NAME=value`; never commit real values.

# Required. OpenRouter API key used by the ai-chat function.
OPENROUTER_API_KEY=

# Recommended in production. Comma-separated origins allowed to call the function.
# Unset = any origin (every request still needs a valid user JWT).
ALLOWED_ORIGINS=http://localhost:5173

# Optional overrides (defaults shown in supabase/functions/ai-chat/index.ts).
# AI_MODEL_CHAT=deepseek/deepseek-v4.1-flash
# AI_MODEL_QUIZ=z-ai/glm-5.3-flash
# AI_MODEL_EXTRACTION=z-ai/glm-5.3-flash
# AI_MODEL_FALLBACK=z-ai/glm-5.3
# AI_TIMEOUT_MS=25000
# OPENROUTER_SITE_URL=https://umenrechnik.app
# OPENROUTER_APP_NAME=Smart Dictionary
