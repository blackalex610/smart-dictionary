# Postgres connection used by the API (Supabase transaction pooler, port 6543).
# Get this from the Supabase dashboard: Project Settings -> Database -> Connection string -> URI.
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-password@aws-x-region.pooler.supabase.com:6543/postgres

# Supabase project URL. Used to derive the JWKS endpoint and expected `iss` claim.
SUPABASE_URL=https://your-project-ref.supabase.co

# Comma-separated list of origins allowed to call this API.
CORS_ALLOW_ORIGINS=http://localhost:5173

ENVIRONMENT=development
