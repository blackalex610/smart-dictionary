# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Only variables prefixed with VITE_ reach the browser bundle, and everything
# that does is PUBLIC. Never put a secret here.

# Supabase project URL and anon (public) key: Project Settings → API.
# The anon key is safe to ship; row-level security is what protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional. Where Google sends the user after sign-in. Defaults to
# `${window.location.origin}/auth/callback`. Must also be listed in
# Supabase → Authentication → URL Configuration → Redirect URLs.
VITE_OAUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# ── Server-side secrets do NOT belong in this file ──────────────────────────
# The AI provider key lives only in the Edge Function environment:
#   supabase secrets set OPENROUTER_API_KEY=...
# For `supabase functions serve` locally, use supabase/functions/.env
# (see supabase/functions/.env.example).
